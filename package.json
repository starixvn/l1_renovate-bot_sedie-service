{
    "name": "sc-sedie",
    "version": "1.0.0",
    "description": "",
    "main": "./src/app.js",
    "scripts": {
        "test": "jest --testPathPattern=tests/unit-tests/",
        "test-coverage": "jest --collect-coverage --testPathPattern=tests/unit-tests/",
        "integration-test": "jest tests/integration-tests/index.test.js --ci --reporters=default --reporters=jest-junit --forceExit",
        "dev": "nodemon --es-module-specifier-resolution=node --watch ./src ./src/app.js",
        "debug": "nodemon --es-module-specifier-resolution=node --watch ./ --inspect ./src/app.js",
        "prod": "node --max-old-space-size=8192 --es-module-specifier-resolution=node ./src/app.js",
        "reg": "npm set registry https://npm.lumigame.com"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "author": "",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "chance": "^1.1.8",
        "nodemon": "^2.0.4",
        "random": "^3.0.6",
        "random-js": "^2.1.0",
        "sc-game-base": "3.0.4",
        "sc-smart-bot": "1.0.0"
    },
    "devDependencies": {
        "@babel/core": "7.16.12",
        "@babel/preset-env": "7.16.11",
        "@commitlint/cli": "17.1.2",
        "@commitlint/config-conventional": "17.1.0",
        "@semantic-release/changelog": "6.0.1",
        "@semantic-release/commit-analyzer": "9.0.2",
        "@semantic-release/git": "10.0.1",
        "@semantic-release/gitlab": "9.4.2",
        "@semantic-release/npm": "9.0.1",
        "@semantic-release/release-notes-generator": "10.0.3",
        "@types/jest": "29.2.0",
        "babel-jest": "29.2.2",
        "husky": "8.0.1",
        "install": "0.13.0",
        "jest": "29.2.2",
        "jest-extended": "3.1.0",
        "jest-junit": "14.0.1",
        "jest-micro-auto-stub": "1.0.9",
        "jest-sonar-reporter": "2.0.0",
        "sc-game-service-integration-utils": "1.2.4",
        "sc-semantic-release": "^1.1.0",
        "semantic-release": "19.0.5"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    },
    "jest": {
        "testResultsProcessor": "jest-junit"
    }
}
