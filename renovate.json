{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "packageRules": [
    {
      "excludePackagePatterns": [
        "*"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor",
        "major",
        "patch",
        "pin",
        "digest"
      ],
      "matchPackageNames": [
        "sc-game-base"
      ]
    }
  ]
}
